<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <!-- Point this at your SQL Server instance. Run Database/01, 02, 03 scripts first. -->
   <add name="TutorConnect"
     connectionString="Data Source=TARIQZULU\SQLEXPRESS;Initial Catalog=TutorConnect;Integrated Security=True;TrustServerCertificate=True"
     providerName="System.Data.SqlClient" />
  </connectionStrings>

  <appSettings>
    <add key="webpages:Version" value="3.0.0.0" />
    <add key="webpages:Enabled" value="false" />
    <add key="ClientValidationEnabled" value="true" />
    <add key="UnobtrusiveJavaScriptEnabled" value="true" />

    <!-- Public URL of the site (used in emails and PayFast return/notify URLs). Leave empty to use the current host.
         For PayFast ITN on a dev machine, expose the site with a tunnel (e.g. ngrok) and put that URL here. -->
    <add key="SiteBaseUrl" value="" />

    <!-- /Setup: database health check and one-click installer. It opens by itself while the database is missing;
         once installed only an administrator can reach it. Set to false on a production server. -->
    <add key="Setup:Enabled" value="true" />

    <!-- How students pay.
         BankTransfer = TutorConnect's own bank-payment checkout. This is a SIMULATION for development and demonstrations:
                        the booking, receipt and tutor payout steps all run, but no money moves. Only the bank name and the
                        last four digits of the account are stored.
         PayFast      = PayFast's hosted checkout (set PayFast:Sandbox to false and use your own merchant details for real payments). -->
    <add key="Payments:Mode" value="BankTransfer" />

    <!-- Pricing -->
    <add key="HourlyRate" value="105" />

    <!-- PayFast. The defaults are PayFast's public sandbox merchant. Use your own account + passphrase in production. -->
    <add key="PayFast:MerchantId" value="10000100" />
    <add key="PayFast:MerchantKey" value="46f0cd694581a" />
    <add key="PayFast:Passphrase" value="" />
    <add key="PayFast:Sandbox" value="true" />
    <add key="PayFast:ValidateWithServer" value="true" />
    <!-- DEV ONLY (sandbox only): completes the payment on the return page because PayFast's ITN can't reach localhost.
         Set to false as soon as the site is reachable by PayFast, and always in production. -->
    <add key="PayFastSimulateItn" value="true" />

    <!-- Payouts: "Logging" records payout instructions in App_Data/payouts.log (no money moves).
         Implement IPayoutProvider for a licensed provider and add it to PayoutProviderFactory. -->
    <add key="PayoutProvider" value="Logging" />

    <!-- AI study assistant (Claude API). Create a key at https://platform.claude.com and paste it here.
         Leave it empty to switch the assistant off. Never commit a real key to GitHub. -->
    <add key="Anthropic:ApiKey" value="" />
    <add key="Anthropic:Model" value="claude-haiku-4-5-20251001" />
    <!-- Without a Claude key the assistant uses a free local AI if Ollama is running on this computer
         (install from ollama.com, then run: ollama pull llama3.2), and otherwise a built-in offline study helper. -->
    <add key="Ollama:Enabled" value="true" />
    <add key="Ollama:Url" value="http://127.0.0.1:11434" />
    <add key="Ollama:Model" value="llama3.2" />
    <add key="Ai:HourlyLimit" value="20" />
    <add key="Ai:MaxTokens" value="1200" />

    <!-- Email (Gmail SMTP needs an App Password, not your normal password).
         While Smtp:Enabled is false, emails are written to App_Data/emails.log. -->
   <add key="Smtp:Enabled" value="true" />
<add key="Smtp:Host" value="smtp.gmail.com" />
<add key="Smtp:Port" value="587" />
<add key="Smtp:EnableSsl" value="true" />
<add key="Smtp:User" value="zulusphephile576@gmail.com" />
<add key="Smtp:Pass" value="szktufpcytirlohw" />
<add key="Smtp:From" value="zulusphephile576@gmail.com" />

  </appSettings>

  <system.web>
    <!-- debug="false" makes pages compile faster (batch compilation, optimised code). If you press F5 to debug,
         Visual Studio offers to switch it on; Ctrl+F5 (run without debugging) doesn't need it. -->
    <compilation debug="false" batch="true" optimizeCompilations="true" targetFramework="4.8" />
    <!-- 50 MB per request so phone photos never hit the server limit; each file is checked individually in code (10 MB). -->
    <httpRuntime targetFramework="4.8" maxRequestLength="51200" enableVersionHeader="false" requestValidationMode="4.5" />
    <globalization culture="en-US" uiCulture="en-US" requestEncoding="utf-8" responseEncoding="utf-8" fileEncoding="utf-8" />
    <sessionState mode="InProc" timeout="60" cookieless="false" />
    <httpCookies httpOnlyCookies="true" requireSSL="false" />
    <customErrors mode="RemoteOnly" defaultRedirect="~/Home/Error">
      <error statusCode="404" redirect="~/Home/NotFound" />
    </customErrors>
    <!-- Encrypts bank account numbers (SecretProtector). Generate NEW keys for your own deployment
         and keep them stable: changing them makes stored account numbers unreadable. -->
    <machineKey validation="HMACSHA256" decryption="AES"
                validationKey="ECB01DBE2CD383C1E4B0FFC940C80C7F9CDAF458DDCB582C4F4DCDF563D865516D90F19B5BF87A2B7859CF1053F808575A720C0F1D8ABE079DB96509BE30E345"
                decryptionKey="EC6B9EDE4C5662D2186E405DCBC77F87FF478876504FB43E94CF21AAAF2C6F72" />
  </system.web>

  <system.webServer>
    <!-- Browsers keep stylesheets, scripts and images for 30 days. Their URLs include the file's last-changed time
         (Ui.Asset), so an updated file is always fetched again. -->
    <staticContent>
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="30.00:00:00" />
    </staticContent>
    <urlCompression doStaticCompression="true" doDynamicCompression="true" />
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="52428800" />
      </requestFiltering>
    </security>
    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>
    <handlers>
      <remove name="ExtensionlessUrlHandler-Integrated-4.0" />
      <remove name="OPTIONSVerbHandler" />
      <remove name="TRACEVerbHandler" />
      <add name="ExtensionlessUrlHandler-Integrated-4.0" path="*." verb="*" type="System.Web.Handlers.TransferRequestHandler" preCondition="integratedMode,runtimeVersionv4.0" />
    </handlers>
  </system.webServer>

  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="System.Web.Helpers" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="1.0.0.0-3.0.0.0" newVersion="3.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Web.WebPages" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="1.0.0.0-3.0.0.0" newVersion="3.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Web.Mvc" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="0.0.0.0-5.2.9.0" newVersion="5.2.9.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Microsoft.Web.Infrastructure" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="0.0.0.0-2.0.0.0" newVersion="2.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Web.Razor" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="1.0.0.0-3.0.0.0" newVersion="3.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Web.WebPages.Razor" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="1.0.0.0-3.0.0.0" newVersion="3.0.0.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>
