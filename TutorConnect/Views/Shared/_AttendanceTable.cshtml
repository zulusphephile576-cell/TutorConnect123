@model List<AttendanceRecord>
@* Attendance records with summary and filters (lecturer: own modules, admin: everything). *@
@{
    var modules = Model.Select(r => r.ModuleCode).Distinct().OrderBy(c => c).ToList();
    var marked = Model.Count(r => r.Status != null);
    var attended = Model.Count(r => r.Status == "Present" || r.Status == "Late");
    var rate = Ui.Pct(attended, marked);
}
<div class="stats mb">
    <div class="stat"><div class="stat-top">Records<span class="stat-icon"><i class="fa-solid fa-clipboard-list"></i></span></div><div class="stat-value">@Model.Count</div></div>
    <div class="stat"><div class="stat-top">Present<span class="stat-icon success"><i class="fa-solid fa-check"></i></span></div><div class="stat-value">@Model.Count(r => r.Status == "Present")</div></div>
    <div class="stat"><div class="stat-top">Absent<span class="stat-icon danger"><i class="fa-solid fa-xmark"></i></span></div><div class="stat-value">@Model.Count(r => r.Status == "Absent")</div></div>
    <div class="stat feature"><div class="stat-top">Attendance rate</div><div class="stat-value">@(marked == 0 ? "\u2013" : rate + "%")</div><div class="progress @Ui.RateTone(rate)" style="margin-top:8px"><span style="width:@(rate)%"></span></div></div>
</div>
<div class="card">
    <div class="table-tools" data-filter-table="#att">
        <div class="search"><i class="fa-solid fa-magnifying-glass"></i><input type="search" placeholder="Search student, tutor or title" aria-label="Search attendance" /></div>
        <select data-filter-attr="module" aria-label="Filter by module" style="width:auto"><option value="">All modules</option>@foreach (var m in modules) { <option>@m</option> }</select>
        <select data-filter-attr="source" aria-label="Filter by type" style="width:auto"><option value="">All types</option><option>Session</option><option>Tutorial</option><option>Class register</option></select>
        <select data-filter-attr="status" aria-label="Filter by status" style="width:auto"><option value="">All statuses</option><option>Present</option><option>Absent</option></select>
        <button type="button" class="btn btn-secondary btn-sm" onclick="window.print()"><i class="fa-solid fa-print"></i>Print</button>
    </div>
    <div class="table-wrap">
        <table class="table" id="att">
            <thead><tr><th>Date</th><th>Student</th><th>Module</th><th>Type</th><th>What</th><th>Tutor</th><th>Status</th></tr></thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr data-module="@r.ModuleCode" data-source="@r.Source" data-status="@r.Status">
                        <td class="nowrap">@Ui.Date(r.Date)</td>
                        <td><div>@r.StudentName</div><div class="small muted">@r.StudentNumber</div></td>
                        <td><span class="tag">@r.ModuleCode</span></td>
                        <td>@r.Source</td>
                        <td>@r.Title</td>
                        <td>@r.TutorName</td>
                        <td>@Ui.Badge(r.Status)</td>
                    </tr>
                }
                <tr class="no-results"><td colspan="7"><div class="empty">Nothing matches your filters.</div></td></tr>
            </tbody>
        </table>
    </div>
    @if (Model.Count == 0) { <div class="empty"><i class="fa-solid fa-clipboard"></i><p>No attendance has been recorded yet.</p></div> }
</div>
