@model List<Booking>
@{
    ViewBag.Title = "Reports";
    var s = (Dictionary<string, object>)ViewBag.Summary;
    var byModule = (List<ModuleSummary>)ViewBag.ByModule;
    Func<string, decimal> num = k => s.ContainsKey(k) && s[k] != null ? Convert.ToDecimal(s[k]) : 0m;
}
<div class="page-head">
    <div><h1>Reports</h1><p>Your tutoring history and earnings. Payouts are sent automatically after each completed payment.</p></div>
    <div class="page-actions"><button type="button" class="btn btn-secondary" onclick="window.print()"><i class="fa-solid fa-print"></i>Print</button></div>
</div>

<div class="stats mb">
    <div class="stat"><div class="stat-top">Sessions booked<span class="stat-icon"><i class="fa-solid fa-calendar"></i></span></div><div class="stat-value">@num("TotalSessions")</div><div class="stat-note">@num("CompletedSessions") completed</div></div>
    <div class="stat"><div class="stat-top">Hours tutored<span class="stat-icon info"><i class="fa-solid fa-hourglass-half"></i></span></div><div class="stat-value">@num("HoursTutored")</div></div>
    <div class="stat"><div class="stat-top">Tutorials run<span class="stat-icon warning"><i class="fa-solid fa-chalkboard-user"></i></span></div><div class="stat-value">@num("TutorialsRun")</div></div>
    <div class="stat feature"><div class="stat-top">Paid out<span class="stat-icon success"><i class="fa-solid fa-money-bill-wave"></i></span></div><div class="stat-value">@Ui.Money(num("PaidOut"))</div><div class="stat-note">@Ui.Money(num("PayoutsPending")) not yet sent</div></div>
</div>

<div class="grid grid-aside">
    <div class="card">
        <div class="card-head"><h2>All sessions</h2></div>
        <div class="table-wrap">
            <table class="table">
                <thead><tr><th>Date</th><th>Student</th><th>Module</th><th>Hours</th><th>Amount</th><th>Status</th></tr></thead>
                <tbody>
                    @foreach (var b in Model)
                    {
                        <tr><td class="nowrap">@Ui.Date(b.StartTime)</td><td>@b.StudentName</td><td><span class="tag">@b.ModuleCode</span></td><td>@b.Hours</td><td class="mono">@Ui.Money(b.Amount)</td><td>@Ui.Badge(b.Status)</td></tr>
                    }
                </tbody>
            </table>
        </div>
        @if (Model.Count == 0) { <div class="empty"><p>No sessions yet.</p></div> }
    </div>
    <div class="card" style="align-self:start">
        <div class="card-head"><h2>By module</h2></div>
        @if (byModule.Count == 0)
        {
            <div class="empty"><p>No data yet.</p></div>
        }
        else
        {
            <ul class="list">
                @foreach (var m in byModule)
                {
                    <li class="list-item"><div class="list-main"><div class="list-title"><span class="tag">@m.ModuleCode</span> @m.ModuleName</div><div class="list-meta">@m.Sessions sessions, @m.Hours hours completed</div></div></li>
                }
            </ul>
        }
    </div>
</div>
