@model RegisterSheetViewModel
@{
    var t = Model.Tutorial;
    ViewBag.Title = "Register: " + t.Title;
}
<a class="back-link" href="@Url.Action("Tutorials")"><i class="fa-solid fa-arrow-left"></i>All tutorials</a>
<div class="page-head">
    <div>
        <span class="tag">@t.ModuleCode</span> <span class="small muted">Year @t.YearOfStudy</span>
        <h1 style="margin-top:8px">@t.Title</h1>
        <p>@Ui.TimeRange(t.StartTime, t.EndTime)@(string.IsNullOrEmpty(t.Venue) ? "" : ", " + t.Venue). Changes save as soon as you click. QR check-ins appear here by themselves.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-primary" href="@Url.Action("QrCode", new { id = t.TutorialId })"><i class="fa-solid fa-qrcode"></i>Show QR code</a>
        <button type="button" class="btn btn-secondary" onclick="window.print()"><i class="fa-solid fa-print"></i>Print</button>
    </div>
</div>
<div data-live-url="@Url.Action("LiveCount", new { id = t.TutorialId })">
    @Html.Partial("_Sheet", Model.Students, new ViewDataDictionary { { "MarkUrl", Url.Action("MarkAttendance") }, { "Key", "tutorialId" }, { "Id", t.TutorialId } })
</div>
