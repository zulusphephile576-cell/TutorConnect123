@using TutorConnect.Services
@{
    ViewBag.Title = "AI study assistant";
    var modules = (List<TutorConnect.Controllers.AssistantController.ModuleOption>)ViewBag.Modules;
    var selected = ViewBag.Selected as TutorConnect.Controllers.AssistantController.ModuleOption;
    var history = (List<AiService.Turn>)ViewBag.History;
    var configured = (bool)ViewBag.Configured;
    var provider = (AiService.Provider)ViewBag.Provider;
    var modes = (string[])ViewBag.Modes;
    var remaining = (int)ViewBag.Remaining;
    var limit = (int)ViewBag.Limit;
    var isTutor = (Session["Role"] as string) == "Tutor";
}
<div class="page-head">
    <div>
        <h1>AI study assistant</h1>
        <p>@(isTutor ? "Plan tutorials, write practice questions and explain tricky ideas for the modules you tutor." : "Get concepts explained, practise with questions, and plan your studying for your own modules.")</p>
    </div>
    @if (selected != null && history.Count > 0)
    {
        using (Html.BeginForm("Reset", "Assistant", new { module = selected.Code }, FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-secondary"><i class="fa-solid fa-rotate-left"></i>New conversation</button>
        }
    }
</div>

@if (modules.Count == 0)
{
    <div class="card"><div class="empty"><i class="fa-solid fa-book"></i><p>@(isTutor ? "You're not assigned to any modules yet." : "You have no registered modules yet.") The assistant works per module.</p></div></div>
}
else
{
    <div class="ai-layout">
        <aside class="card ai-modules">
            <div class="card-head"><h2>@(isTutor ? "Modules you tutor" : "Your modules")</h2></div>
            <nav class="list">
                @foreach (var m in modules)
                {
                    <a class="ai-module @(selected != null && selected.Code == m.Code ? "active" : null)" href="@Url.Action("Index", new { module = m.Code })">
                        <span class="tag">@m.Code</span><span class="ai-module-name">@m.Name</span>
                    </a>
                }
            </nav>
            <div class="card-foot small muted">
                <b data-ai-remaining>@remaining</b> of @limit questions left this hour.
            </div>
        </aside>

        <section class="card ai-chat" data-ai-chat data-url="@Url.Action("Ask")" data-module="@selected.Code">
            <div class="ai-chat-head">
                <span class="ai-avatar"><i class="fa-solid fa-wand-magic-sparkles"></i></span>
                <div><b>@selected.Code study assistant</b><div class="small muted">@selected.Name@(selected.Year.HasValue ? ", year " + selected.Year : "")</div></div>
                <span class="ai-engine ai-engine-@provider.Key" data-ai-engine title="@(provider.Key == "offline" ? (AiService.OllamaProblem ?? "No AI engine is available right now.") : "Answers are generated by this AI engine.")"><i class="fa-solid @(provider.Key == "offline" ? "fa-book-open" : "fa-microchip")"></i><span data-ai-engine-label>@provider.Label@(provider.Model == null ? "" : " (" + provider.Model + ")")</span></span>
            </div>

            <div class="ai-messages" data-ai-messages aria-live="polite">
                @if (history.Count == 0)
                {
                    <div class="ai-welcome" data-ai-welcome>
                        <h3>What would you like help with in @selected.Code?</h3>
                        <p class="muted small">Pick a mode below, or start with one of these.</p>
                        <div class="ai-suggestions">
                            @if (isTutor)
                            {
                                <button type="button" data-ai-suggest data-mode="tutorial">Plan a 60-minute tutorial on the hardest topic this term</button>
                                <button type="button" data-ai-suggest data-mode="practice">Five practice questions for next week's tutorial</button>
                                <button type="button" data-ai-suggest data-mode="explain">A simple way to explain this module's key idea to first-years</button>
                            }
                            else
                            {
                                <button type="button" data-ai-suggest data-mode="explain">Explain the main idea of this module in simple terms</button>
                                <button type="button" data-ai-suggest data-mode="practice">Give me five practice questions to test myself</button>
                                <button type="button" data-ai-suggest data-mode="plan">Make me a 7-day study plan for my next test</button>
                            }
                        </div>
                    </div>
                }
                @foreach (var t in history)
                {
                    <div class="ai-msg ai-@t.Role"><div class="ai-bubble" data-ai-md>@t.Text</div></div>
                }
            </div>

            <form class="ai-composer" data-ai-form>
                <div class="ai-modes" role="radiogroup" aria-label="What kind of help">
                    @for (var i = 0; i < modes.Length; i++)
                    {
                        <label><input type="radio" name="mode" value="@modes[i]" @(i == 0 ? "checked" : null) /><span>@AiService.ModeLabel(modes[i])</span></label>
                    }
                </div>
                <div class="ai-input">
                    <label for="aiMessage" class="sr-only">Your question</label>
                    <textarea id="aiMessage" name="message" rows="2" maxlength="2000" placeholder="Ask about @selected.Code&hellip; (Enter to send, Shift+Enter for a new line)" @(configured ? null : "disabled")></textarea>
                    <button type="submit" class="btn btn-primary" @(configured ? null : "disabled") aria-label="Send"><i class="fa-solid fa-paper-plane"></i></button>
                </div>
                <p class="ai-note"><i class="fa-solid fa-shield-halved"></i>@(provider.Key == "claude" ? "Answers come from Claude, an AI, and can be wrong;" : provider.Key == "ollama" ? "Answers come from an AI running on this computer and can be wrong;" : "The offline helper gives study steps, not answers;") check important points with your @(isTutor ? "lecturer" : "tutor"). Don't paste personal information. Only the module name and your year are shared.</p>
            </form>
        </section>
    </div>
}
