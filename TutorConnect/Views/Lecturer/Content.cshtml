@model List<ContentItem>
@{
    ViewBag.Title = "Course content";
    var modules = (List<Module>)ViewBag.Modules;
}
<div class="page-head">
    <div><h1>Course content</h1><p>Share material with the tutors on your modules, and review what tutors upload.</p></div>
</div>

<div class="grid grid-aside">
    <div class="card">
        <div class="table-tools" data-filter-table="#content">
            <div class="search"><i class="fa-solid fa-magnifying-glass"></i><input type="search" placeholder="Search title, module or uploader" aria-label="Search content" /></div>
            <select data-filter-attr="year" aria-label="Filter by year of study" style="width:auto"><option value="">All years</option>@for (var y = 1; y <= 4; y++) { <option value="@y">Year @y</option> }</select>
            <select data-filter-attr="role" aria-label="Filter by uploader" style="width:auto"><option value="">Everyone</option><option>Lecturer</option><option>Tutor</option></select>
        </div>
        <div class="table-wrap">
            <table class="table" id="content">
                <thead><tr><th>Material</th><th>Module</th><th>Uploaded by</th><th>Review</th><th class="right"><span class="sr-only">Actions</span></th></tr></thead>
                <tbody>
                    @foreach (var c in Model)
                    {
                        <tr data-role="@c.UploaderRole" data-year="@(c.YearOfStudy.HasValue ? c.YearOfStudy.Value.ToString() : "1,2,3,4,5,6,7")">
                            <td><div class="list-title">@c.Title</div>@if (!string.IsNullOrEmpty(c.Description)) { <div class="small muted">@c.Description</div> }</td>
                            <td><span class="tag">@c.ModuleCode</span>@if (c.YearOfStudy.HasValue) { <span class="small muted"> Y@c.YearOfStudy</span> }</td>
                            <td><div>@(c.UploaderName ?? "Removed user")</div><div class="small muted">@c.UploaderRole, @Ui.Ago(c.UploadedAt)</div></td>
                            <td>
                                @if (c.IsReviewed) { <span class="badge badge-success">Reviewed</span><div class="small muted">@c.ReviewedByName</div> }
                                else { <span class="badge badge-warning">@(c.UploaderRole == "Tutor" ? "Needs your review" : "Tutors to review")</span> }
                            </td>
                            <td>
                                <div class="actions">
                                    <a class="btn btn-secondary btn-sm" href="@Url.Action("Content", "Files", new { id = c.ContentId })"><i class="fa-solid fa-download"></i>Open</a>
                                    @if (!c.IsReviewed && c.UploaderRole == "Tutor")
                                    {
                                        using (Html.BeginForm("ReviewContent", "Lecturer", new { id = c.ContentId }, FormMethod.Post))
                                        {
                                            @Html.AntiForgeryToken()<button type="submit" class="btn btn-success btn-sm">Mark reviewed</button>
                                        }
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                    <tr class="no-results"><td colspan="5"><div class="empty">Nothing matches.</div></td></tr>
                </tbody>
            </table>
        </div>
        @if (Model.Count == 0) { <div class="empty"><i class="fa-regular fa-folder-open"></i><p>No material shared yet.</p></div> }
    </div>

    <div class="card" style="align-self:start">
        <div class="card-head"><h2>Upload material</h2></div>
        @if (modules.Count == 0)
        {
            <div class="card-body"><p class="muted" style="margin:0">No modules are linked to you yet.</p></div>
        }
        else
        {
            using (Html.BeginForm("UploadContent", "Lecturer", FormMethod.Post, new { enctype = "multipart/form-data" }))
            {
                @Html.AntiForgeryToken()
                <div class="card-body stack" style="gap:14px">
                    <div class="field"><label for="yearOfStudy">Year of study</label>
                        <select id="yearOfStudy" name="yearOfStudy" data-year-source="#moduleId" required>
                            <option value="">Choose a year</option>
                            @foreach (var y in modules.Select(x => x.YearLevel).Distinct().OrderBy(x => x)) { <option value="@y">Year @y</option> }
                        </select></div>
                    <div class="field"><label for="moduleId">Module</label>
                        <select id="moduleId" name="moduleId" required disabled>
                            <option value="">Choose a year first</option>
                            @foreach (var m in modules) { <option value="@m.ModuleId" data-year="@m.YearLevel">@m.Code, @m.Name</option> }
                        </select>
                        <span class="hint">Only the modules you lecture in that year.</span></div>
                    <div class="field"><label for="title">Title</label><input type="text" id="title" name="title" maxlength="150" required /></div>
                    <div class="field"><label for="description">Description</label><textarea id="description" name="description" maxlength="1000" style="min-height:80px"></textarea></div>
                    <div class="field"><label for="file">File</label><input type="file" id="file" name="file" required /><span class="hint">Up to 10 MB.</span></div>
                    <button type="submit" class="btn btn-primary btn-block"><i class="fa-solid fa-upload"></i>Upload</button>
                </div>
            }
        }
    </div>
</div>
