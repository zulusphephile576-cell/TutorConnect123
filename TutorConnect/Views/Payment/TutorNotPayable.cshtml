@model Payment
@{
    ViewBag.Title = "Payment unavailable";
}
<div style="max-width:560px;margin:0 auto">
    <div class="card">
        <div class="card-body" style="text-align:center;padding:36px 28px">
            <div class="stat-icon warning" style="margin:0 auto 16px;width:60px;height:60px;font-size:1.5rem;border-radius:50%"><i class="fa-solid fa-building-columns"></i></div>
            <h1>@Model.TutorName can't receive payments yet</h1>
            <p class="text-2" style="margin-top:8px">Your tutor hasn't added the bank account that payments go to. We've let them know. You haven't been charged.</p>
            <div class="summary-line" style="margin-top:16px"><span class="muted">Session</span><span>@Model.ModuleCode, @Ui.DateTime(Model.SessionStart)</span></div>
            <div class="summary-line"><span class="muted">Amount</span><span>@Ui.Money(Model.Amount)</span></div>
            <div class="row" style="justify-content:center;margin-top:20px">
                <a class="btn btn-primary" href="@Url.Action("Cancel", new { reference = Model.PaymentRef })">Choose another time or tutor</a>
                <a class="btn btn-secondary" href="@Url.Action("Dashboard", "Student")">Dashboard</a>
            </div>
        </div>
    </div>
</div>
