@model Payment
@{
    ViewBag.Title = "Payment";
    var done = Model.Status == "Complete";
    var pending = Model.Status == "Pending";
}
<div style="max-width:560px;margin:0 auto">
    <div class="card" data-payment-status-url="@(pending ? Url.Action("Status", new { reference = Model.PaymentRef }) : null)">
        <div class="card-body" style="text-align:center;padding:36px 28px">
            @if (done)
            {
                <div class="stat-icon success" style="margin:0 auto 16px;width:60px;height:60px;font-size:1.6rem;border-radius:50%"><i class="fa-solid fa-circle-check"></i></div>
                <h1>Payment sent</h1>
                <p class="text-2" style="margin-top:8px">Your @Model.ModuleCode session request on @Ui.DateTime(Model.SessionStart) has been sent to @Model.TutorName. You'll see it confirmed under My bookings once they approve it.</p>
            }
            else if (pending)
            {
                <div class="stat-icon" style="margin:0 auto 16px;width:60px;height:60px;font-size:1.5rem;border-radius:50%"><i class="fa-solid fa-spinner fa-spin-pulse"></i></div>
                <h1>Waiting for PayFast</h1>
                <p class="text-2" style="margin-top:8px">We're waiting for PayFast to confirm your payment. This page updates by itself, usually within a few seconds.</p>
            }
            else
            {
                <div class="stat-icon danger" style="margin:0 auto 16px;width:60px;height:60px;font-size:1.5rem;border-radius:50%"><i class="fa-solid fa-circle-xmark"></i></div>
                <h1>Payment @Model.Status.ToLowerInvariant()</h1>
                <p class="text-2" style="margin-top:8px">No booking was created and you haven't been charged by TutorConnect.</p>
            }
            <div class="summary-line" style="margin-top:16px"><span class="muted">Amount</span><span>@Ui.Money(Model.Amount)</span></div>
            <div class="summary-line"><span class="muted">Reference</span><span class="mono small">@Model.PaymentRef</span></div>
            @if (done && !string.IsNullOrEmpty(Model.PayerBank))
            {
                <div class="summary-line"><span class="muted">@(Model.PaymentMethod == "Card" ? "Paid with" : "Paid from")</span><span>@Model.PayerBank •••• @Model.PayerAccountLast4</span></div>
                <div class="summary-line"><span class="muted">Transaction ID</span><span class="mono small">@Model.PfPaymentId</span></div>
                <div class="summary-line"><span class="muted">Paid on</span><span>@(Model.CompletedAt.HasValue ? Ui.DateTime(Model.CompletedAt.Value) : "")</span></div>
            }
            <div class="row" style="justify-content:center;margin-top:20px">
                <a class="btn btn-primary" href="@Url.Action("Bookings", "Student")">My bookings</a>
                <a class="btn btn-secondary" href="@Url.Action("Dashboard", "Student")">Dashboard</a>
            </div>
        </div>
    </div>
</div>
