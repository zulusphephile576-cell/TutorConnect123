@model List<Booking>
@{
    ViewBag.Title = "My bookings";
}
<div class="page-head">
    <div><h1>My bookings</h1><p>Every one-on-one session you've requested. Upcoming pending or confirmed sessions can be cancelled.</p></div>
    <div class="page-actions"><a class="btn btn-primary" href="@Url.Action("FindTutor")"><i class="fa-solid fa-plus"></i>Book a session</a></div>
</div>

<div class="card">
    <div class="table-tools" data-filter-table="#bookings">
        <div class="search"><i class="fa-solid fa-magnifying-glass"></i><input type="search" placeholder="Search module or tutor" aria-label="Search bookings" /></div>
        <select data-filter-attr="status" aria-label="Filter by status" style="width:auto">
            <option value="">All statuses</option>
            <option>Pending</option><option>Confirmed</option><option>Completed</option><option>Declined</option><option>Cancelled</option>
        </select>
    </div>
    <div class="table-wrap">
        <table class="table" id="bookings">
            <thead><tr><th>Session</th><th>Tutor</th><th>When</th><th>Paid</th><th>Status</th><th>Attendance</th><th class="right"><span class="sr-only">Actions</span></th></tr></thead>
            <tbody>
                @foreach (var b in Model)
                {
                    <tr data-status="@b.Status">
                        <td><span class="tag">@b.ModuleCode</span><div class="small muted">@b.ModuleName</div></td>
                        <td><div class="person">@Ui.Avatar(b.TutorName, "sm")<span>@b.TutorName</span></div></td>
                        <td class="nowrap">@Ui.TimeRange(b.StartTime, b.EndTime)<div class="small muted">@b.Hours @(b.Hours == 1 ? "hour" : "hours")</div></td>
                        <td class="mono">@Ui.Money(b.Amount)</td>
                        <td>@Ui.Badge(b.Status)</td>
                        <td>@(b.AttendanceStatus == null ? Html.Raw("<span class=\"muted small\">Not yet</span>") : Ui.Badge(b.AttendanceStatus))</td>
                        <td>
                            <div class="actions">
                                @if (b.IsUpcoming && (b.Status == "Pending" || b.Status == "Confirmed"))
                                {
                                    using (Html.BeginForm("CancelBooking", "Student", new { id = b.BookingId }, FormMethod.Post, new { data_confirm = "Cancel this session? The tutor will be notified." }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-danger btn-sm">Cancel</button>
                                    }
                                }
                            </div>
                        </td>
                    </tr>
                }
                <tr class="no-results"><td colspan="7"><div class="empty">No bookings match your filters.</div></td></tr>
            </tbody>
        </table>
    </div>
    @if (Model.Count == 0)
    {
        <div class="empty"><i class="fa-regular fa-calendar"></i><p>You haven't booked a session yet.</p><a class="btn btn-primary btn-sm" href="@Url.Action("FindTutor")">Find a tutor</a></div>
    }
</div>
<p class="small muted mt">Cancelling does not trigger an automatic refund. Speak to your tutor or an administrator if you need one.</p>
