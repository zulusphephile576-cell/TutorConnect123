@model ForgotPasswordViewModel
@{
    ViewBag.Title = "Reset your password";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
    var roles = new[] { "Student", "Tutor", "Lecturer", "Admin" };
}
<a class="back-link" href="@Url.Action("Login", "Account")"><i class="fa-solid fa-arrow-left"></i>Back to sign in</a>
<h2>Confirm it's you</h2>
<p class="text-2">Enter the details on your account. Once they match, you can choose a new password straight away.</p>

@using (Html.BeginForm("ForgotPassword", "Account", FormMethod.Post, new { novalidate = "novalidate" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "alert alert-error" })
    <fieldset class="segmented" style="margin:18px 0 20px;border:0">
        <legend class="sr-only">Account type</legend>
        @foreach (var r in roles)
        {
            <label><input type="radio" name="Role" value="@r" @(Model.Role == r ? "checked" : null) /><span>@r</span></label>
        }
    </fieldset>
    <div class="stack" style="gap:16px">
        <div class="field">@Html.LabelFor(m => m.Email)@Html.TextBoxFor(m => m.Email, new { type = "email", autocomplete = "email" })@Html.ValidationMessageFor(m => m.Email)</div>
        <div class="field">@Html.LabelFor(m => m.LastName)@Html.TextBoxFor(m => m.LastName, new { autocomplete = "family-name" })@Html.ValidationMessageFor(m => m.LastName)</div>
        <div class="field">
            @Html.LabelFor(m => m.StudentNumber)
            @Html.TextBoxFor(m => m.StudentNumber)
            <span class="hint">Required for student and tutor accounts.</span>
            @Html.ValidationMessageFor(m => m.StudentNumber)
        </div>
        <button type="submit" class="btn btn-primary btn-lg btn-block">Continue</button>
    </div>
}
