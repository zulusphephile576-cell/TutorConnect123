@model ResetPasswordViewModel
@{
    ViewBag.Title = "Choose a new password";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}
<h2>Choose a new password</h2>
<p class="text-2">This link works once and expires after 15 minutes.</p>
@using (Html.BeginForm("ResetPassword", "Account", FormMethod.Post, new { novalidate = "novalidate" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.Token)
    @Html.ValidationSummary(true, "", new { @class = "alert alert-error" })
    <div class="stack" style="gap:16px;margin-top:18px">
        <div class="field">@Html.LabelFor(m => m.NewPassword)@Html.PasswordFor(m => m.NewPassword, new { autocomplete = "new-password", autofocus = "autofocus", data_strength = "" })<span class="hint">At least 8 characters.</span>@Html.ValidationMessageFor(m => m.NewPassword)</div>
        <div class="field">@Html.LabelFor(m => m.ConfirmPassword)@Html.PasswordFor(m => m.ConfirmPassword, new { autocomplete = "new-password" })@Html.ValidationMessageFor(m => m.ConfirmPassword)</div>
        <button type="submit" class="btn btn-primary btn-lg btn-block">Save new password</button>
    </div>
}
