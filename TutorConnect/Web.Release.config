<?xml version="1.0" encoding="utf-8"?>
<!-- Applied automatically when you PUBLISH (Release). Your local Web.config is not changed.
     Fill in the four values marked REPLACE before publishing. Don't commit real passwords to GitHub. -->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <connectionStrings>
    <!-- REPLACE: paste the .NET connection string from your host's control panel (MonsterASP: Databases -> your database). -->
    <add name="TutorConnect"
         connectionString="Server=REPLACE_SERVER;Database=REPLACE_DATABASE;User Id=REPLACE_USER;Password=REPLACE_PASSWORD;Encrypt=True;TrustServerCertificate=True;MultipleActiveResultSets=True"
         xdt:Transform="SetAttributes" xdt:Locator="Match(name)" />
  </connectionStrings>
  <appSettings>
    <!-- REPLACE: your public address, e.g. https://tutorconnect.runasp.net (used in QR codes and emails). -->
    <add key="SiteBaseUrl" value="https://REPLACE.runasp.net" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <!-- Leave true for the first publish so you can install the database at /Setup; then set false and publish again. -->
    <add key="Setup:Enabled" value="true" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <!-- The host has no local AI: the assistant uses Claude if Anthropic:ApiKey is set, otherwise the offline helper. -->
    <add key="Ollama:Enabled" value="false" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
  </appSettings>
  <system.web>
    <!-- the live site uses HTTPS, so cookies are only sent over HTTPS -->
    <httpCookies requireSSL="true" xdt:Transform="SetAttributes" />
    <compilation debug="false" xdt:Transform="SetAttributes" />
  </system.web>
</configuration>
