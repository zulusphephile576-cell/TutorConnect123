<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- Tests never call external services. -->
    <add key="Holidays:UseApi" value="false" />
    <add key="Ollama:Enabled" value="false" />
    <!-- The real-world mistakes EmailAndNetworkTests check the app corrects or reports -->
    <add key="Smtp:Enabled" value="false" />
    <add key="Smtp:Host" value="someone@gmail.com" />
    <add key="Smtp:Port" value="465" />
    <add key="Smtp:User" value="someone@gmail.com" />
    <add key="Smtp:From" value="TutorConnect" />
    <add key="Ollama:Url" value="http://localhost:11434" />
    <add key="PayFast:ValidateWithServer" value="false" />
  </appSettings>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="System.Web.Mvc" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="0.0.0.0-5.2.9.0" newVersion="5.2.9.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Web.WebPages" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="1.0.0.0-3.0.0.0" newVersion="3.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Web.Helpers" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="1.0.0.0-3.0.0.0" newVersion="3.0.0.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>
