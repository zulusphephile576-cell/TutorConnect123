    {
      "name": "1. Public endpoints",
      "item": [
        {
          "name": "API index lists endpoints",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const d = pm.response.json().data;",
                  "pm.test(\"Describes itself\", () => pm.expect(d.endpoints.length).to.be.above(10));",
                  "pm.test(\"Uses SAST and rand\", () => { pm.expect(d.timeZone).to.include(\"South African\"); pm.expect(d.currency).to.include(\"ZAR\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1"
              ]
            },
            "description": ""
          }
        },
