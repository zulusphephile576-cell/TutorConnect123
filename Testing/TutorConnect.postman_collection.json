        {
          "name": "Departments are only from the chosen faculty",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const d = pm.response.json().data;",
                  "const fid = Number(pm.collectionVariables.get(\"facultyId\"));",
                  "pm.test(\"Every department belongs to the faculty\", () => d.forEach(x => pm.expect(x.facultyId).to.eql(fid)));",
                  "const it = d.find(x => x.name === \"Information Technology\") || d[0];",
                  "if (it) pm.collectionVariables.set(\"departmentId\", it.id);"
                ]
              }
            }
          ],
