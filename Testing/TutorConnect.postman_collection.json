              "mode": "raw",
              "raw": "{\n  \"email\": \"{{studentEmail}}\",\n  \"password\": \"{{password}}\",\n  \"role\": \"Student\",\n  \"name\": \"Postman tests\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
