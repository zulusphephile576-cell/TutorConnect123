                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const d = pm.response.json().data;",
                  "pm.test(\"Has faculties\", () => pm.expect(d.length).to.be.above(0));",
                  "const fai = d.find(f => f.name.includes(\"Accounting and Informatics\")) || d[0];",
