        {
          "name": "South African public holidays 2026 (external API)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const d = pm.response.json().data;",
                  "pm.test(\"Country is ZA\", () => pm.expect(d.country).to.eql(\"ZA\"));",
                  "pm.test(\"Freedom Day is 27 April\", () => pm.expect(d.holidays.some(h => h.date === \"2026-04-27\")).to.be.true);",
                  "pm.test(\"Good Friday 2026 is 3 April\", () => pm.expect(d.holidays.some(h => h.date === \"2026-04-03\")).to.be.true);",
                  "pm.test(\"Source reported\", () => pm.expect(d.source).to.be.a(\"string\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/holidays?year=2026",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
