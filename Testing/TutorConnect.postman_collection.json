          "name": "Student signs in and gets a token (201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201 Created\", () => pm.response.to.have.status(201));",
                  "const d = pm.response.json().data;",
                  "pm.test(\"Bearer token returned\", () => { pm.expect(d.tokenType).to.eql(\"Bearer\"); pm.expect(d.token).to.match(/^tc_[A-Za-z0-9]{40}$/); });",
                  "pm.test(\"Expiry is SAST\", () => pm.expect(d.expiresAt).to.match(/\\+02:00$/));",
                  "pm.test(\"Role is Student\", () => pm.expect(d.user.role).to.eql(\"Student\"));",
                  "pm.collectionVariables.set(\"studentToken\", d.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
